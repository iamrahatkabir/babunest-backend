DATABASE_URL=postgres://user:password@host:5432/database
PAYLOAD_SECRET=change-me
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3001

# Vercel Blob token for product image storage. Optional.
# Leave unset and uploads go to ./media on local disk. A host with an ephemeral
# filesystem needs remote storage instead; see DEPLOYMENT.md.
BLOB_READ_WRITE_TOKEN=
