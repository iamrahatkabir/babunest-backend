DATABASE_URL=postgres://user:password@host:5432/database
PAYLOAD_SECRET=change-me
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
STOREFRONT_URL=http://localhost:3001

# Vercel Blob token for product image storage.
# Leave unset locally: uploads then fall back to the local filesystem.
# Required in any deployed environment, since Vercel's filesystem is ephemeral.
BLOB_READ_WRITE_TOKEN=
